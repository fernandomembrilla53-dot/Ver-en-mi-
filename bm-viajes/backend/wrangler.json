{
  "name": "bm-viajes-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "vars": {
    "FRONTEND_ORIGIN": "https://fernandomembrilla53-dot.github.io",
    "ENABLE_LIVE_RIDES": "false",
    "MP_SANDBOX_ENABLED": "false",
    "ENFORCE_DRIVER_REVIEW": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bm-viajes-db",
      "database_id": "5593c40b-39b6-494b-8131-a0f708d11d86"
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
